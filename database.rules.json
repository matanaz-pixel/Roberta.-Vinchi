{
  "rules": {
    ".read": false,
    ".write": false,
    "bank": {
      ".read": true,
      "$id": {
        ".write": true,
        ".validate": "newData.hasChildren(['name'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
        },
        "station": {
          ".validate": "newData.isString() && (newData.val() == '' || newData.val() == 'tabun' || newData.val() == 'cold' || newData.val() == 'hot' || newData.val() == 'wash')"
        },
        "photo": {
          ".validate": "newData.isString() && newData.val().length <= 120000 && newData.val().matches(/^data:image\\/(png|jpeg|webp);base64,[A-Za-z0-9+\\/=]+$/)"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "breaks": {
      ".read": true,
      "$id": {
        ".write": true,
        ".validate": "newData.hasChildren(['minutes', 'endAt'])",
        "minutes": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 180"
        },
        "endAt": {
          ".validate": "newData.isNumber()"
        },
        "muted": {
          ".validate": "newData.isBoolean()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "history": {
      ".read": true,
      "$entry": {
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['chefId', 'chefName', 'minutes', 'finishedAt', 'status'])",
        "chefId": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "chefName": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "minutes": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 180"
        },
        "startedAt": {
          ".validate": "newData.isNumber()"
        },
        "finishedAt": {
          ".validate": "newData.isNumber()"
        },
        "status": {
          ".validate": "newData.val() == 'completed' || newData.val() == 'cancelled'"
        },
        "overtimeSeconds": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "stock": {
      ".read": true,
      "$date": {
        ".validate": "$date.matches(/^\\d{4}-\\d{2}-\\d{2}$/)",
        "$station": {
          ".validate": "$station == 'cold' || $station == 'hot' || $station == 'tabun'",
          "$count": {
            ".write": "!data.exists() && newData.exists()",
            ".validate": "newData.hasChildren(['t', 'by', 'items'])",
            "t": {
              ".validate": "newData.isNumber() && newData.val() > 1700000000000 && newData.val() <= now + 3600000"
            },
            "by": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
            },
            "items": {
              ".validate": "newData.hasChildren() && newData.numChildren() <= 150",
              "$item": {
                ".validate": "$item.length <= 60 && newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
              }
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    }
  }
}